ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_WORKSPACE_ID=your_anthropic_workspace_id_here

ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Offline mode. Both default to true when unset, so a development run never
# reaches a real API. Set both to false for a live run.
USE_FIXTURES=true
USE_LLM_STUB=true
